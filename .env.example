# Google Gemini AI API Keys
GEMINI_API_KEY_PRIMARY=your_primary_gemini_api_key
GEMINI_API_KEY_BACKUP=your_backup_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash

# Telegram Bot Token (từ @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Google Sheets Real-time Sync (Tùy chọn)
GOOGLE_SHEETS_WEBHOOK_URL=your_apps_script_exec_url
GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/your_sheet_id/edit

# Phân quyền Telegram (Tùy chọn)
ALLOWED_TELEGRAM_USERS=

